{
  // MCAA Football Engine — Cloudflare Worker (API) + static React site + D1 database.
  // Import this repo in the Cloudflare dashboard (Workers & Pages → Create → Import a repository).
  //   Build command:  (leave empty)
  //   Deploy command: npx wrangler deploy
  // The D1 database below has no database_id on purpose: Wrangler provisions it automatically on
  // the first deploy, and the Worker creates/migrates its own tables on the first request.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcaa-football9",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Wrangler builds the React site itself before every deploy, so "npx wrangler deploy" is the only command Cloudflare needs.
  "build": { "command": "npm run build", "watch_dir": "src" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "mcaa-football-db","database_id": "7e68af93-f561-4b84-b4db-a0877e5126a2" }
  ],
  "observability": { "enabled": true }
  // Team percentages are stored in the D1 database above and edited in the admin dashboard; no percentage API is used.
  // Secrets (set in the dashboard or with `wrangler secret put`):
  //   SETUP_TOKEN         required once, to create the four administrator accounts at /setup
  //   ANTHROPIC_API_KEY   optional, enables AI recaps and screenshot reading
}
